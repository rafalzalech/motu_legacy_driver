PRODUCT_NAME = MOTU SMPTE Setup
MOTU_DRIVERS_ROOT = $(PROJECT_DIR)/../../..
SYMROOT = $(MOTU_DRIVERS_ROOT)/Builds/Mac
OBJROOT = $(SYMROOT)/Intermediates    // put intermediates here to reduce clutter

#include "../../../Prefix/Mac/xcconfigs/MOTUDriverVersion"

INFOPLIST_FILE = Info.plist
WRAPPER_EXTENSION = app
OTHER_LDFLAGS = $(OTHER_LDFLAGS) -l xml2
GCC_WARN_UNUSED_VARIABLE = YES
HEADER_SEARCH_PATHS = "$(MOTU_DRIVERS_ROOT)/AwesomeLib/Includes" $(MOTU_DRIVERS_ROOT)/NotFromMOTU/Boost/
GCC_PREFIX_HEADER = $(SRCROOT)/../Source/SMPTE_Prefix_Mac.pch

