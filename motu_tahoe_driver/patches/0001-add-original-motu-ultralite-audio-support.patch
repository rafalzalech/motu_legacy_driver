+    EXPECT_EQ(packet.framesInPacket, 6U);
+    EXPECT_EQ(packet.dbc, 6U);
+    EXPECT_EQ(packet.syt, 0xFFFFU);
+
+    // DBS=13, SPH=1 and end-event DBC=6 in CIP Q0; MOTU fmt/fdf and
+    // SYT_NO_INFO in Q1.
